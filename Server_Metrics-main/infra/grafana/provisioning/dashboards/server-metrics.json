{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(148, 163, 184, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Minimal dark overview for server telemetry and logs.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "type": "text",
      "title": "",
      "gridPos": { "h": 3, "w": 24, "x": 0, "y": 0 },
      "options": {
        "mode": "markdown",
        "content": "# SYSTEM / TELEMETRY\n### Live infrastructure signal · **5s refresh**\n\n`●` All systems are being observed in real time"
      },
      "transparent": true
    },
    {
      "type": "stat",
      "title": "CPU LOAD",
      "description": "Current CPU utilization",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 3 },
      "datasource": { "type": "influxdb", "uid": "influxdb-main" },
      "targets": [
        {
          "query": "from(bucket: \"metrics\") |> range(start: v.timeRangeStart, stop: v.timeRangeStop) |> filter(fn: (r) => r._measurement == \"server_metrics\" and r._field == \"cpu_percent\") |> last()",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 0,
          "color": { "mode": "fixed", "fixedColor": "#8fb8b0" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#6f9b85", "value": null },
              { "color": "#b39a68", "value": 70 },
              { "color": "#b56f7c", "value": 90 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value_and_name"
      }
    },
    {
      "type": "stat",
      "title": "MEMORY PRESSURE",
      "description": "Current memory utilization",
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 3 },
      "datasource": { "type": "influxdb", "uid": "influxdb-main" },
      "targets": [
        {
          "query": "from(bucket: \"metrics\") |> range(start: v.timeRangeStart, stop: v.timeRangeStop) |> filter(fn: (r) => r._measurement == \"server_metrics\" and r._field == \"memory_percent\") |> last()",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 0,
          "color": { "mode": "fixed", "fixedColor": "#9a91b8" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#6f9b85", "value": null },
              { "color": "#b39a68", "value": 75 },
              { "color": "#b56f7c", "value": 90 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value_and_name"
      }
    },
    {
      "type": "stat",
      "title": "MEMORY USED",
      "description": "Memory currently in use",
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 3 },
      "datasource": { "type": "influxdb", "uid": "influxdb-main" },
      "targets": [
        {
          "query": "from(bucket: \"metrics\") |> range(start: v.timeRangeStart, stop: v.timeRangeStop) |> filter(fn: (r) => r._measurement == \"server_metrics\" and r._field == \"memory_used_bytes\") |> last()",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "decimals": 1,
          "color": { "mode": "fixed", "fixedColor": "#8fa9bf" }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value_and_name"
      }
    },
    {
      "type": "stat",
      "title": "REPORTING HOSTS",
      "description": "Number of hosts reporting in the selected range",
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 3 },
      "datasource": { "type": "influxdb", "uid": "influxdb-main" },
      "targets": [
        {
          "query": "from(bucket: \"metrics\") |> range(start: v.timeRangeStart, stop: v.timeRangeStop) |> filter(fn: (r) => r._measurement == \"server_metrics\" and r._field == \"cpu_percent\") |> group(columns: [\"host\"]) |> distinct(column: \"host\") |> count()",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": { "mode": "fixed", "fixedColor": "#8fb8b0" }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "/^host$/", "values": false },
        "textMode": "value_and_name"
      }
    },
    {
      "type": "timeseries",
      "title": "RESOURCE PULSE",
      "description": "CPU and memory utilization over the selected range",
      "gridPos": { "h": 9, "w": 14, "x": 0, "y": 8 },
      "datasource": { "type": "influxdb", "uid": "influxdb-main" },
      "targets": [
        {
          "query": "from(bucket: \"metrics\") |> range(start: v.timeRangeStart, stop: v.timeRangeStop) |> filter(fn: (r) => r._measurement == \"server_metrics\" and (r._field == \"cpu_percent\" or r._field == \"memory_percent\"))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 0,
            "gradientMode": "none",
            "showPoints": "auto",
            "spanNulls": true
          },
          "color": { "mode": "fixed", "fixedColor": "#8fb8b0" }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "cpu_percent" },
            "properties": [{ "id": "displayName", "value": "CPU" }, { "id": "color", "value": { "mode": "fixed", "fixedColor": "#8fb8b0" } }]
          },
          {
            "matcher": { "id": "byName", "options": "memory_percent" },
            "properties": [{ "id": "displayName", "value": "MEMORY" }, { "id": "color", "value": { "mode": "fixed", "fixedColor": "#9a91b8" } }]
          }
        ]
      },
      "options": {
        "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "type": "timeseries",
      "title": "MEMORY FOOTPRINT",
      "description": "Used and available memory in bytes",
      "gridPos": { "h": 9, "w": 10, "x": 14, "y": 8 },
      "datasource": { "type": "influxdb", "uid": "influxdb-main" },
      "targets": [
        {
          "query": "from(bucket: \"metrics\") |> range(start: v.timeRangeStart, stop: v.timeRangeStop) |> filter(fn: (r) => r._measurement == \"server_metrics\" and (r._field == \"memory_used_bytes\" or r._field == \"memory_total_bytes\"))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 0,
            "gradientMode": "none",
            "showPoints": "auto",
            "spanNulls": true
          },
          "color": { "mode": "fixed", "fixedColor": "#8fa9bf" }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "memory_used_bytes" },
            "properties": [{ "id": "displayName", "value": "USED" }, { "id": "color", "value": { "mode": "fixed", "fixedColor": "#8fa9bf" } }]
          },
          {
            "matcher": { "id": "byName", "options": "memory_total_bytes" },
            "properties": [{ "id": "displayName", "value": "TOTAL" }, { "id": "color", "value": { "mode": "fixed", "fixedColor": "#596575" } }]
          }
        ]
      },
      "options": {
        "legend": { "calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "type": "logs",
      "title": "EVENT STREAM",
      "description": "Latest events received by Loki",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 17 },
      "datasource": { "type": "loki", "uid": "loki-main" },
      "targets": [
        {
          "expr": "{job=\"server_metrics_logs\"}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "options": {
        "deduplication": true,
        "enableLogDetails": true,
        "prettifyLogMessage": true,
        "showCommonLabels": false,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLines": true
      }
    }
  ],
  "refresh": "5s",
  "schemaVersion": 39,
  "style": "dark",
  "tags": ["server", "telemetry", "futuristic"],
  "templating": { "list": [] },
  "time": { "from": "now-30m", "to": "now" },
  "timepicker": { "refresh_intervals": ["5s", "10s", "30s", "1m", "5m"], "time_options": ["5m", "15m", "30m", "1h", "6h", "12h", "24h"] },
  "timezone": "browser",
  "title": "Server Metrics // Nightwatch",
  "uid": "server-metrics-nightwatch",
  "version": 1,
  "weekStart": ""
}
